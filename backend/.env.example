FRONTEND_ORIGIN=http://127.0.0.1:43871
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_SECONDS=3600
# Run audio transcription and local visual extraction as parallel branches.
ENABLE_PIPELINE_PARALLELISM=1

# Knowledge asset phase 1 feature switches.
ENABLE_KNOWLEDGE_AUTO_BUILD=1
ENABLE_KNOWLEDGE_SEARCH=1
ENABLE_KNOWLEDGE_STATUS_UI=1
ENABLE_KNOWLEDGE_REBUILD=1
KNOWLEDGE_OWNER_SCOPE=local

# Optional semantic retrieval. Keep SQLite for the zero-setup Demo, or use
# PostgreSQL + pgvector for indexed vector search.
ENABLE_KNOWLEDGE_EMBEDDINGS=0
ENABLE_KNOWLEDGE_SEMANTIC_SEARCH=1
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_VERSION=default
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=auto
SEMANTIC_RECALL_K=60
# DATABASE_URL=postgresql+asyncpg://snapnote:snapnote@127.0.0.1:5432/snapnote

DEFAULT_ASR_PROVIDER=whisper
ENABLE_LOCAL_WHISPER=1
WHISPER_MODEL_SIZE=large-v3
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
# Leave empty to reuse the current user's Hugging Face cache.
WHISPER_CACHE_DIR=

MIMO_API_KEY=
# Token Plan keys (tp-...) use https://token-plan-cn.xiaomimimo.com/v1 by default.
# Standard API keys use https://api.xiaomimimo.com/v1 by default.
MIMO_BASE_URL=
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_LANGUAGE=zh
MIMO_ASR_CHUNK_SECONDS=90
MIMO_ASR_MP3_BITRATE=32k
MIMO_ASR_CONCURRENCY=3
MIMO_ASR_TIMEOUT_SECONDS=90
MIMO_ASR_MAX_ATTEMPTS=2
MIMO_ASR_HEARTBEAT_SECONDS=10
MIMO_ASR_FALLBACK_RETRY=0

# MiMo v2.5 visual understanding. Reuses MIMO_API_KEY and MIMO_BASE_URL above.
ENABLE_MIMO_VISION=1
MIMO_VISION_REQUIRED=0
MIMO_VISION_MODEL=mimo-v2.5
MIMO_VISION_IMAGE_BATCH_SIZE=8
MIMO_VISION_CONCURRENCY=2
MIMO_VISION_TIMEOUT_SECONDS=180
MIMO_VISION_MAX_ATTEMPTS=3
MIMO_VISION_MAX_CLIPS=4
MIMO_VISION_CLIP_SECONDS=8
MIMO_VISION_VIDEO_FPS=2

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

FRAME_FALLBACK_INTERVAL_SECONDS=60
FRAME_MAX_COUNT=24
FRAME_ANALYSIS_FPS=2
FRAME_ANALYSIS_WIDTH=320
FRAME_OUTPUT_WIDTH=736
SCENE_CHANGE_THRESHOLD=0.24
SCENE_MIN_DURATION_SECONDS=1.5
SCENE_MAX_DURATION_SECONDS=45
FRAME_DYNAMIC_THRESHOLD=0.12
FRAME_PHASH_THRESHOLD=6
FFMPEG_BIN=
FFPROBE_BIN=
